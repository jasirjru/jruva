# Backend Environment Configuration Template
# Duplicate to backend/.env for local backend development

# ==============================================================================
# 1. AI Model API Credentials
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Free-capacity fallbacks (all optional; names only, never commit values) ---
# Groq and Gemini limits are per model, so each listed model adds a separate free bucket.
GROQ_FALLBACK_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b"
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Extra OpenAI-compatible free tiers. A vendor is used only when its *_API_KEY is set.
# *_MODELS (comma-separated) and *_BASE_URL are optional overrides of built-in defaults.
MISTRAL_API_KEY=
MISTRAL_MODELS=
# Workers AI chat fallback; also needs CLOUDFLARE_ACCOUNT_ID. Shares the 10,000 neurons/day with image generation.
CLOUDFLARE_API_KEY=
CLOUDFLARE_MODELS=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Web Search (Tavily: Preferred real-time search engine; falls back to DuckDuckGo/Wikipedia)
# Obtain key from: https://tavily.com (Stored server-side only; never expose to frontend)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SECONDS=5.0

# Genuine images: disabled until verified free account and private storage setup.
IMAGE_GENERATION_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
IMAGE_CF_FREE_PLAN_VERIFIED=false
IMAGE_CF_KLEIN_ENABLED=false
IMAGE_CF_KLEIN_FREE_VERIFIED=false
IMAGE_DAILY_NEURON_LIMIT=1000
IMAGE_USER_DAILY_ATTEMPTS=5

DEFAULT_PROVIDER=auto
ENABLE_AUTO_FAILOVER=true

# ==============================================================================
# 2. Security, Authentication & Cryptography
# ==============================================================================
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_cryptographically_secure_random_32_byte_jwt_secret_here
CSRF_SECRET_KEY=your_cryptographically_secure_random_32_byte_csrf_secret_here

# Arbitrary Python execution: disabled by default in production.
# Never enable on public-facing deployments without container isolation.
ENABLE_UNSAFE_LOCAL_CODE_EXECUTION=false

# ==============================================================================
# 3. Vector Storage (Qdrant Cloud or Standalone)
# ==============================================================================
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# ==============================================================================
# 4. Database & Persistence (PostgreSQL / Supabase)
# ==============================================================================
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# 5. Backend Core Settings
# ==============================================================================
ENVIRONMENT=development
DEBUG=false
PORT=8001
HOST=0.0.0.0

ALLOWED_ORIGINS=http://localhost:3121,http://127.0.0.1:3121,http://localhost:3000,http://localhost:3005,https://jruva.in,https://www.jruva.in
RATE_LIMIT_PER_MINUTE=60
BENCHMARK_MODE=false
BENCHMARK_BYPASS_SECRET=
